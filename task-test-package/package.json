{
  "name": "taskboard-task-test-package",
  "version": "1.0.0",
  "private": true,
  "description": "Portable TaskBoard assessment skill and test framework",
  "scripts": {
    "test": "vitest run",
    "qa:unit": "vitest run --config assessment/framework/vitest.config.ts",
    "qa:e2e": "playwright test --config assessment/framework/playwright.config.ts",
    "qa:known-bugs": "playwright test --config assessment/framework/known-bugs.config.ts",
    "qa:performance": "node assessment/framework/performance.cjs"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
